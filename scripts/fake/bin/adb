#!/usr/bin/env python3
import sys, json, os, time, subprocess, signal
S=os.environ["FAKE"]+"/state.json"
args=sys.argv[1:]
st=json.load(open(S)) if os.path.exists(S) else {}
serial=None
if args[:1]==["-s"]: serial=args[1]; args=args[2:]
cmd=args[0] if args else ""
PHYS="TEST-DEVICE-001"
if cmd=="devices":
    print("List of devices attached")
    for k in st: print(f"{k:<22} device product:sdk_gphone64_x86_64 model:sdk_gphone64_x86_64 device:emu64xa transport_id:1")
    print(f"{PHYS:<22} device usb:1-1 product:panther model:Pixel_7 device:panther transport_id:2")
    sys.exit(0)
if cmd=="mdns":
    if args[1:2]==["services"]:
        print("List of discovered mdns services")
        print("adb-TEST-DEVICE-001-xyz\t_adb-tls-connect._tcp.\t192.0.2.50:41235")
        pf=os.environ["FAKE"]+"/qr_name"
        if os.path.exists(pf): print(open(pf).read().strip()+"\t_adb-tls-pairing._tcp.\t192.0.2.50:37001")
    sys.exit(0)
if cmd=="pair": print("Successfully paired to "+args[1]+" [guid=adb-TEST-DEVICE-001-xyz]"); sys.exit(0)
if cmd=="connect": print("connected to "+args[1]); sys.exit(0)
if cmd in ("kill-server","start-server","disconnect"): print("ok"); sys.exit(0)
if serial is None: sys.exit(1)
if serial.startswith("emulator-") and serial not in st: print("error: device not found",file=sys.stderr); sys.exit(1)
e=st.get(serial)
if cmd=="emu":
    sub=args[1:]
    if sub[:2]==["avd","name"]: print(e["avd"]); print("OK"); sys.exit(0)
    if sub[:1]==["kill"]:
        try: os.kill(e["pid"],signal.SIGTERM)
        except Exception: pass
        st.pop(serial); json.dump(st,open(S,"w")); print("OK: killing emulator, bye bye"); sys.exit(0)
    print("OK"); sys.exit(0)
if cmd=="shell":
    script=" ".join(args[1:])
    if "sys.boot_completed" in script and e:
        print("1" if time.time()>e["boot_at"] else "0"); sys.exit(0)
    env=dict(os.environ); env["PATH"]=os.environ["FAKE"]+"/dev:"+env["PATH"]
    r=subprocess.run(["sh","-c",script],env=env); sys.exit(r.returncode)
if cmd=="exec-out":
    import zlib, struct
    def chunk(t,d): c=struct.pack(">I",len(d))+t+d; return c+struct.pack(">I",zlib.crc32(t+d)&0xffffffff)
    W,H=90,160
    raw=b"".join(b"\x00"+b"".join(bytes([x*255//W,y*255//H,180]) for x in range(W)) for y in range(H))  # filter byte 0 + RGB gradient per row
    sys.stdout.buffer.write(b"\x89PNG\r\n\x1a\n"+chunk(b"IHDR",struct.pack(">IIBBBBB",W,H,8,2,0,0,0))+chunk(b"IDAT",zlib.compress(raw))+chunk(b"IEND",b""))
    sys.exit(0)
if cmd=="logcat":
    if "-c" in args: sys.exit(0)
    i=0
    while True:
        lv="IDWEV"[i%5]
        print(f"10-23 12:00:{i%60:02d}.{i%1000:03d}  1234  1250 {lv} Tag{i%4}: message number {i} hello world",flush=True)
        i+=1; time.sleep(0.15)
if cmd in ("install","install-multiple"):
    print("Performing Streamed Install"); time.sleep(0.5); print("Success"); sys.exit(0)
if cmd in ("push","pull"):
    for p in (10,50,100): sys.stdout.write(f"[{p:3d}%] {args[-1]}\r"); sys.stdout.flush(); time.sleep(0.2)
    print(f"\n1 file {cmd}ed."); sys.exit(0)
if cmd in ("forward","reverse"): print("host-5554 tcp:8080 tcp:8080" if "--list" in args else "ok"); sys.exit(0)
print("ok")
