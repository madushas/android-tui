# tiny key/value store used by the fake device tools
kv_get(){ awk -F'\t' -v k="$2" '$1==k{print $2; f=1} END{exit f?0:1}' "$1" 2>/dev/null; }
kv_put(){ touch "$1"; awk -F'\t' -v k="$2" '$1!=k' "$1" > "$1.n"; printf '%s\t%s\n' "$2" "$3" >> "$1.n"; mv "$1.n" "$1"; }
kv_del(){ [ -f "$1" ] || return 0; awk -F'\t' -v k="$2" '$1!=k' "$1" > "$1.n"; mv "$1.n" "$1"; }
